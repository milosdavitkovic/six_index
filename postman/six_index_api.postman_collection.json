    {
      "name": "Index reviews",
      "item": [
        {
          "name": "Run review",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{protocol}}://{{host}}:{{port}}/api/index-reviews/{{indexCode}}/{{reviewPeriod}}/run",
              "protocol": "{{protocol}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "index-reviews",
                "{{indexCode}}",
                "{{reviewPeriod}}",
                "run"
              ]
            },
            "description": "Runs the deterministic review flow for the integration-test scenario (`SMI` / `Q3-2026`)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('matches the integration-test scenario', function () {",
                  "  pm.expect(body.indexCode).to.equal(pm.environment.get('indexCode'));",
                  "  pm.expect(body.reviewPeriod).to.equal(pm.environment.get('reviewPeriod'));",
                  "  pm.expect(body.status).to.equal('COMPLETED_WITH_WARNINGS');",
                  "  pm.expect(body.constituents).to.have.lengthOf(20);",
                  "  pm.expect(body.joiners).to.include(177);",
                  "  pm.expect(body.leavers).to.include(103);",
                  "});",
                  "",
                  "pm.test('captures the reviewResultId for follow-up requests', function () {",
                  "  pm.expect(body.reviewResultId).to.exist;",
                  "  pm.environment.set('reviewResultId', String(body.reviewResultId));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Run review - invalid configuration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{protocol}}://{{host}}:{{port}}/api/index-reviews/{{invalidIndexCode}}/{{reviewPeriod}}/run",
              "protocol": "{{protocol}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "index-reviews",
                "{{invalidIndexCode}}",
                "{{reviewPeriod}}",
                "run"
              ]
            },
            "description": "Matches the integration test that expects a 400 `INVALID_REQUEST` response for `SMIM` / `Q3-2026`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('returns INVALID_REQUEST', function () {",
                  "  pm.expect(body.status).to.equal(400);",
                  "  pm.expect(body.errorCode).to.equal('INVALID_REQUEST');",
                  "});"
                ]
              }
            }
          ]
        },

{
  "info": {
    "_postman_id": "2a8b3f40-2c7a-4e24-9d07-0cb0a98c3d8e",
    "name": "six_index API",
    "description": "Postman collection for the `com.six.indexreview.api` endpoints.\n\nThe review requests and test assertions mirror `IndexReviewControllerIntegrationTest`:\n- `SMI` / `Q3-2026` review run\n- `177` as the audit security id\n- `SMIM` as the invalid configuration example\n\nFor multipart imports, attach the CSV files from the repo `data/` folder:\n- `data/spi_universe.csv`\n- `data/sec_data.csv`\n- `data/composition.csv`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get API health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{protocol}}://{{host}}:{{port}}/api/health",
              "protocol": "{{protocol}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Health probe for the running application."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('returns UP and the application name', function () {",
                  "  pm.expect(body).to.deep.equal({ status: 'UP', service: 'index-review' });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Import",
      "item": [
        {
          "name": "Import all datasets",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "spiUniverse",
                  "type": "file",
                  "src": "data/spi_universe.csv"
                },
                {
                  "key": "securityData",
                  "type": "file",
                  "src": "data/sec_data.csv"
                },
                {
                  "key": "composition",
                  "type": "file",
                  "src": "data/composition.csv"
                }
              ]
            },
            "url": {
              "raw": "{{protocol}}://{{host}}:{{port}}/api/import/all",
              "protocol": "{{protocol}}",
              "host": [
                "{{host}}"
              ],
              "port": "{{port}}",
              "path": [
                "api",
                "import",
                "all"
              ]
            },
            "description": "Imports the three sample CSVs used by the integration tests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('returns dataset summary for all three imports', function () {",
                  "  pm.expect(body.spiUniverse.dataset).to.equal('SPI_UNIVERSE');",
                  "  pm.expect(body.spiUniverse.inputRows).to.equal(409);",
                  "  pm.expect(body.spiUniverse.storedRows).to.equal(409);",
                  "  pm.expect(body.spiUniverse.deduplicatedRows).to.equal(0);",
                  "  pm.expect(body.securityData.dataset).to.equal('SECURITY_DATA');",
                  "  pm.expect(body.securityData.inputRows).to.equal(409);",
                  "  pm.expect(body.securityData.storedRows).to.equal(409);",
                  "  pm.expect(body.securityData.deduplicatedRows).to.equal(0);",
                  "  pm.expect(body.composition.dataset).to.equal('COMPOSITION');",
                  "  pm.expect(body.composition.inputRows).to.equal(20);",
                  "  pm.expect(body.composition.storedRows).to.equal(20);",
                  "  pm.expect(body.composition.deduplicatedRows).to.equal(0);",
                  "});"
                ]
              }
            }
          ]
        },

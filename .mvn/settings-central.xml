<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings template.

  This file provides a convenient local settings wrapper to point the
  Maven wrapper at your internal Artifactory and (optionally) provide
  credentials for repositories that require authentication.

  Usage (from repo root):
    ./mvnw -s .mvn/settings-central.xml clean install

  IMPORTANT: Do not commit real credentials to a public repository.
  Replace placeholders below with local values or keep this file out of VCS.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <!-- Servers: add <server> entries for repository ids used in your POMs -->
  <servers>
    <!-- If the failing resolver used repository id 'central', provide credentials here -->
    <server>
      <id>central</id>
      <username>YOUR_USERNAME_HERE</username>
      <password>YOUR_PASSWORD_OR_API_KEY_HERE</password>
    </server>
    <!-- Add additional servers as needed -->
  </servers>

  <!-- Mirrors: no project-local mirror configured so external Maven Central
       will be used by default. If you need to override repositories for your
       local environment, add mirror entries here (do NOT mirror '*'). -->

  <!-- Optional: add proxies, profiles, or other settings here -->

</settings>
